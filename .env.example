# Set these in Vercel > Project > Settings > Environment Variables.
ANTHROPIC_API_KEY=
ALPACA_KEY=
ALPACA_SECRET=
ALPACA_MODE=paper            # paper | live
LIVE_CONFIRMED=false         # live orders need ALPACA_MODE=live AND this =true
FINNHUB_KEY=
DATABASE_URL=                # Neon pooled connection string
DAILY_BUDGET_USD=14
KILL_WORD=
DASHBOARD_PASSWORD=          # basic auth on every route (any username)
CRON_SECRET=                 # Vercel sends this to the daily watchdog cron
# Local dev only: tick every N seconds instead of the real cadence.
# LOOP_SLEEP_OVERRIDE_SEC=5
